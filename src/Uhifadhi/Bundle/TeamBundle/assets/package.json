{
    "name": "@uhifadhi/team-bundle",
    "description": "Front-end behaviour of the team screens — the grants editor's per-module bulk controls and change preview, the older permission matrix's per-umbrella select-all, the department surfaces' panels, and the performance matrix's in-band sort, mapped into hosts via AssetMapper.",
    "license": "AGPL-3.0-or-later",
    "symfony": {
        "controllers": {
            "permission-group": {
                "main": "controllers/permission_group_controller.js",
                "fetch": "lazy",
                "enabled": true
            },
            "department": {
                "main": "controllers/department_controller.js",
                "fetch": "lazy",
                "enabled": true
            },
            "matrix": {
                "main": "controllers/matrix_controller.js",
                "fetch": "lazy",
                "enabled": true
            },
            "grants": {
                "main": "controllers/grants_controller.js",
                "fetch": "lazy",
                "enabled": true
            }
        },
        "importmap": {}
    }
}
