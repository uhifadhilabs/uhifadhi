{# PM·D — DECLARER PACKS. One pack per package, each naming what it declared
   and what uninstalling it would cost.

   It makes the matrix's REAL BEHAVIOUR the visible thing: that what there is to
   grant grows and shrinks with the installed bundles, because a concern exists
   only by declaration. No single screen ever shows one position whole, which is
   the cost. #}
{% import '@Team/positions/_bits.html.twig' as pm %}

<div class="c" data-pm="d">
    <span class="tab">Declarer packs<span class="src">&middot; the declarations as they grow</span></span>
    <p class="use" style="margin-top:2px">One pack per declarer. The point of this direction is the thing every
    other one leaves implicit: <b>what there is to grant is not fixed</b>, and each pack says who declared it and
    what its removal would cost.</p>

    {# THE LEGEND, because a page of marks has to say what the marks MEAN rather
       than assume it. #}
    <div class="pm-legend">
        <span><span class="pm-by"><i></i>declared by</span> whoever enforces the concern &mdash; and it goes when they do</span>
        <span><span class="pm-by next"><i></i>no longer declared</span> still held by a position, resolving to nothing</span>
    </div>

    {% for declarer, concerns in grouped %}
        {% set pairs = groupPairs[declarer]|default([]) %}
        <div class="pm-pack">
            <div class="pm-umb">
                <b>{{ declarer }}</b>
                <span class="pm-by"><i></i>declared by {{ declarer }}</span>
                <span class="pm-all" style="margin-left:auto">{{ concerns|length }} concern{{ concerns|length == 1 ? '' : 's' }} &middot; {{ pairs|length }} grant{{ pairs|length == 1 ? '' : 's' }}</span>
            </div>
            {% for concern in concerns %}
                {# The inline `for … if` was removed in Twig 3, and a `set`
                   inside a loop does not survive it either — the filter is the
                   replacement and it is clearer about what is being dropped. #}
                {% set concernPairs = verbs|filter(v => concern.supports(v))|map(v => concern.key ~ '.' ~ v.value) %}
                <div class="pm-prow">
                    <span class="pm-t">
                        <b>{{ concern.label }}{% if concern.isSensitive %}<span class="pm-sens">sensitive</span>{% endif %}</b>
                        <span class="perm">{{ concern.key }}</span>
                        <em>{{ concern.description }}</em>
                    </span>
                    <span class="pm-reach">{{ pm.icon_people() }} {{ positions|filter(p => concernPairs|filter(v => v in p.grantValues)|length > 0)|length }}</span>
                </div>
            {% endfor %}
            <div class="pm-cost">
                Remove {{ declarer }} and these rows leave this page on the next request.
                <b>Grants already written stay in the positions</b> and stop resolving &mdash; pruned, not purged.
            </div>
        </div>
    {% endfor %}
</div>
