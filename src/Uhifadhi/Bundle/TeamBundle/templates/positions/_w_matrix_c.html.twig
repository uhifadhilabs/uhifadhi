{# PM·C — GRANT FIRST. The pair is what you open, and you read who holds it:
   the shape of the question an AUDIT asks, so "who can delete a zone" is one
   card rather than one row of eight.

   It is the worst shape for building a new position, which needs visiting every
   card to assemble one — that is the trade, stated rather than hidden.

   A DECLARER IS ONE BOUNDED GROUP with its cards inside it. In the first draft
   the headings were one more strip in a stack of identical boxes, so a reader
   could not see where one package's concerns ended and the next began. #}
{% import '@Team/positions/_bits.html.twig' as pm %}

<div class="c" data-pm="c">
    <span class="tab">Grant first<span class="src">&middot; who holds this one</span></span>
    <p class="use" style="margin-top:2px">Shaped like the question an audit actually asks. Read-only for the same
    reason the grid is: one card reaches every position at once.</p>

    {% for declarer, concerns in grouped %}
        <div class="pm-qgroup">
            <div class="pm-umb">
                <b>{{ declarer }}</b>
                <span class="pm-by"><i></i>declared by {{ declarer }}</span>
            </div>
            {% for concern in concerns %}
                {% for verb in verbs %}
                    {% if concern.supports(verb) %}
                        {% set pair = concern.key ~ '.' ~ verb.value %}
                        {% set holdingPositions = positions|filter(p => pair in p.grantValues) %}
                        <div class="pm-q">
                            <div class="pm-qhead">
                                <b>{{ concern.label }} &middot; {{ verb.label }}{% if concern.isSensitive %}<span class="pm-sens">sensitive</span>{% endif %}</b>
                                <span class="perm">{{ pair }}</span>
                                <span class="pm-reach">{{ pm.icon_people() }} {{ holdingPositions|length }} position{{ holdingPositions|length == 1 ? '' : 's' }}</span>
                            </div>
                            <em class="pm-qdesc">{{ concern.description }} {{ verb.meaning }}</em>
                            <div class="pm-holders">
                                {% for position in holdingPositions %}
                                    <a class="qual" href="{{ path('team_positions', {position: position.uuidString}) }}">
                                        <span class="n">{{ position.name }}</span>
                                    </a>
                                {% else %}
                                    <span class="pm-nobody">{{ pm.icon_info() }} no position grants this</span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </div>
    {% endfor %}
</div>
