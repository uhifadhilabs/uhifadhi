{# @deprecated since 1.0, removed in 1.1 — the positions register is no longer
   a widget canvas; this partial is unreachable and kept only so an
   installation upgrading over one release does not lose a template it may
   have overridden. #}
{# PM·CAT — WHERE EVERY GRANT COMES FROM: the declarations, drawn as a table.

   This is the widget that makes the matrix's central fact legible — nothing
   here is maintained by hand. Whoever enforces a concern declares it, so the
   table says which package gave the installation each group of rows, and what
   removing that package would do to the grants already written. #}
{% import '@Team/positions/_bits.html.twig' as pm %}

<div class="c" data-pm="cat">
    <span class="tab">Where every grant comes from<span class="src">&middot; the declarations, as a table</span></span>
    <p class="use" style="margin-top:2px">A concern exists only by declaration: the code that owns a thing says
    this is a concern of mine, these are the verbs it supports, and this one is sensitive. The team&rsquo;s own
    four will always be here. Every other row arrived when a bundle was installed and <b>leaves when it is
    removed</b> &mdash; on the next request, not the next deploy.</p>

    <table class="tbl" style="margin-top:12px">
        <thead><tr><th>Declared by</th><th>Concern</th><th>Verbs</th><th>If it goes</th></tr></thead>
        <tbody>
            {% for declarer, group in grouped %}
                {% for concern in group %}
                    <tr>
                        <td>{% if loop.first %}<span class="pm-by"><i></i>{{ declarer }}</span>{% else %}<span class="fog">&mdash;</span>{% endif %}</td>
                        <td>
                            <b>{{ concern.label }}{% if concern.isSensitive %}<span class="pm-sens">sensitive</span>{% endif %}</b>
                            <span class="perm">{{ concern.key }}</span>
                        </td>
                        <td>{% for verb in verbs %}{% if concern.supports(verb) %}<span class="perm">{{ verb.value }}</span>{% endif %}{% endfor %}</td>
                        <td>{% if loop.first %}Remove {{ declarer }} and these rows leave on the next request; grants already written stay, pruned rather than purged.{% else %}<span class="fog">as above</span>{% endif %}</td>
                    </tr>
                {% endfor %}
            {% endfor %}
            {% for value, holdingPositions in orphans %}
                <tr class="muted">
                    <td><span class="pm-by next"><i></i>nothing installed</span></td>
                    <td><span class="pm-orphname">no longer described</span> <span class="perm">{{ value }}</span></td>
                    <td class="fog">&mdash;</td>
                    <td>already gone &mdash; still held by {{ holdingPositions|length }} position{{ holdingPositions|length == 1 ? '' : 's' }}, declared by nothing</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
