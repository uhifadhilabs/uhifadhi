{# DEPT·C — one card of positions.

   IT USED TO BE A CARD PER DEPARTMENT, and the reason was that two departments
   could own the same word: Ecology's Analyst and Protection's Analyst had to
   be in separate cards so no amount of skim-reading merged them. A name is
   unique across the organization now, so there is one Analyst. #}
{% import '@Team/positions/_bits.html.twig' as pm %}

<div class="c" data-pm="dept-c">
    <span class="tab">One card<span class="src">&middot; every position</span></span>
    <p class="use" style="margin-top:2px">Every position in one card. A name is <b>unique across the
    organization</b>, so no two rows here are the same word meaning two jobs.</p>

    <div class="tm-cardgrid" style="margin-top:12px">
            <div class="c pm-deptcard">
                <span class="tab"><span class="dtag"><i class="dot"></i>Positions</span></span>
                {% for position in positions %}
                    {% set held = holders[position.uuidString]|default(0) %}
                    <a class="pm-deptrow" href="{{ path('team_positions', {position: position.uuidString}) }}">
                        <b>{{ position.name }}</b>
                        <span class="rh">{% if held %}{{ held }} holder{{ held == 1 ? '' : 's' }}{% else %}<span class="pm-held0">nobody yet</span>{% endif %}
                        &middot; grants {{ position.grantValues|length }}</span>
                    </a>
                {% endfor %}
            </div>
    </div>
</div>
