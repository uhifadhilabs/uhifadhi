{# DEPT·A — one table of every position, with the create row under it.

   IT USED TO BAND BY DEPARTMENT, and the banding was the whole idea: a
   position was filed under a department and the department was the structure
   of the page. A position carries no department now — a department is where a
   PERSON is placed — so the band would be a heading over nothing. #}
{% import '@Team/positions/_bits.html.twig' as pm %}

<div class="c" data-pm="dept-a">
    <span class="tab">One table<span class="src">&middot; every position</span></span>
    <p class="use" style="margin-top:2px">Every position the organization has written, and the control that
    makes a new one. A name is <b>unique across the organization</b>, so there is one of each and the list needs
    no headings to keep them apart.</p>

    <div class="tm-scroll">
        <table class="tbl">
            <thead><tr><th>Position</th><th>Holders</th><th>Grants</th><th></th></tr></thead>
            <tbody>
                    {% for position in positions %}
                        {% set held = holders[position.uuidString]|default(0) %}
                        <tr>
                            <td><b>{{ position.name }}</b></td>
                            <td>{% if held %}{{ held }}{% else %}<span class="pm-held0">nobody yet</span>{% endif %}</td>
                            <td>{% for value in position.permissionValues %}<span class="perm">{{ value }}</span>{% else %}<span class="perm none">nothing</span>{% endfor %}</td>
                            <td class="tm-acts"><a class="open-btn" href="{{ path('team_positions', {position: position.uuidString}) }}">Edit</a></td>
                        </tr>
                    {% endfor %}
                    <tr><td colspan="4">
                        <form class="assign" method="post" action="{{ path('team_position_create') }}">
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                            <input type="text" name="name" class="fld" placeholder="New position" required>
                            <button class="softbtn acc" type="submit">{{ pm.icon_plus() }} Add</button>
                        </form>
                    </td></tr>
            </tbody>
        </table>
    </div>
</div>
