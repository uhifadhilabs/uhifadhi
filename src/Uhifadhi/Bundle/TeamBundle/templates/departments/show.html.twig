{# THE DEPARTMENT LENS — one department's own page, area-aware, openable from
   every row of the manager.

   PORTED from the canonical design DesignsProjects/uhifadhi-web/departments/
   department.html, honouring the ruled PAGE-CHROME THEME:
     · page-level actions live in the header row (the department carries none yet
       — its widget board is the follow-up — so the row holds identity only);
     · the identity CARD (.factband) lives on the OVERVIEW tab ALONE; the
       always-there name and scope live in the header and the scope strip above
       the tabs, so they show on every tab;
     · the KPIs sit on a single row.

   THE ATTACHED MODULES ARE THE LENS, and three of the four tabs read them: they
   lead the Overview one card each, their figures are the whole of Performance,
   and Settings is where they are attached and detached. A department computes no
   number of its own — every figure is a module KPI rolled up through an
   attachment — so a department that leads with nothing shows nothing, and says
   so rather than drawing a zero.

   ATTACHING GRANTS NOTHING AND HIDES NOTHING. The Settings copy says it, because
   a control that looks like a permission matrix has to. #}
{% extends '@Shell/page.html.twig' %}
{% import _self as dp %}
{% import '@Team/departments/_bits.html.twig' as di %}
{% import '@Team/positions/_bits.html.twig' as pm %}

{# THE FIGURES A MODULE REPORTED, DRAWN ONCE EACH.

   The contract asks a provider for ONE SET of KPIs per call — the department's
   own figures at the scope its ref names — and the design draws one row of
   representative tiles per module. A provider that still answers one set PER AREA
   would therefore stack the same label with nothing to tell the copies apart, so
   these two macros draw the totals first and then each area's sets UNDER THE AREA
   NAME THE FIGURE ITSELF CARRIES. Nothing is dropped and nothing is summed here:
   the page renders what it was given, labelled honestly. #}
{% macro kpi_tiles(figures) %}
    {% set areas = figures|reduce((names, kpi) => kpi.isTotal or kpi.areaName in names ? names : names|merge([kpi.areaName]), []) %}
    {% for kpi in figures|filter(kpi => kpi.isTotal) %}
        {# AN UNKNOWN FIGURE IS A DASHED SLOT, never a zero: "we did not measure"
           and "we measured nothing" are different facts, and the value object is
           what draws the distinction. #}
        <div class="c kpi">
            <span class="tab">{{ kpi.moduleName }} &middot; {{ kpi.label }}</span>
            <b class="disp">{{ kpi.display }}{{ kpi.isShare and kpi.isKnown ? '%' : '' }}</b>
        </div>
    {% endfor %}
    {% for areaName in areas %}
        <div class="dp-arealbl">{{ areaName }}</div>
        {% for kpi in figures|filter(kpi => kpi.areaName == areaName) %}
            <div class="c kpi">
                <span class="tab">{{ kpi.moduleName }} &middot; {{ kpi.label }}</span>
                <b class="disp">{{ kpi.display }}{{ kpi.isShare and kpi.isKnown ? '%' : '' }}</b>
            </div>
        {% endfor %}
    {% endfor %}
{% endmacro %}

{% macro kpi_rows(figures) %}
    {% set areas = figures|reduce((names, kpi) => kpi.isTotal or kpi.areaName in names ? names : names|merge([kpi.areaName]), []) %}
    {% for kpi in figures|filter(kpi => kpi.isTotal) %}
        <div class="rln"><span class="k">{{ kpi.label }}</span><span class="v">{{ kpi.display }}{{ kpi.isShare and kpi.isKnown ? '%' : '' }}</span></div>
    {% endfor %}
    {% for areaName in areas %}
        <div class="dp-arealbl">{{ areaName }}</div>
        {% for kpi in figures|filter(kpi => kpi.areaName == areaName) %}
            <div class="rln"><span class="k">{{ kpi.label }}</span><span class="v">{{ kpi.display }}{{ kpi.isShare and kpi.isKnown ? '%' : '' }}</span></div>
        {% endfor %}
    {% endfor %}
{% endmacro %}

{% set area = department.area %}
{% set isArea = area is not null %}

{% block title %}{{ department.name }} — department{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_page_tabs %}{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> /
    <a href="{{ path('team_departments') }}">departments</a> / {{ department.name }}
{% endblock %}

{# The header carries the mark, the name and — so name+scope read on EVERY tab —
   the scope badge, beside the one-line description. #}
{% block shell_page_head %}
    <div class="dpthead">
        <span class="mark">{{ mark }}</span>
        <div>
            <h1 class="pg">{{ department.name }}
                {% if isArea %}
                    <span class="scope area">{{ di.icon_area() }} {{ area.name }}</span>
                {% else %}
                    <span class="scope org">{{ di.icon_org() }} Org-level</span>
                {% endif %}
            </h1>
            <p class="pgsub">A department&rsquo;s own dashboard, where the modules it attaches lead the view. It
                shapes emphasis &mdash; never access.</p>
        </div>
    </div>
{% endblock %}

{% block shell_page %}
    {{ include('@Team/team/_scope_banner.html.twig') }}
    <div data-dept="{{ department.uuidString }}" data-controller="uhifadhi--team-bundle--department">

        {# AREA-AWARE READING — set by scope. Above the tabs, so scope reads on
           every tab. Area-level is fixed to its one area; org-level reads across
           every area. #}
        <div class="scoperule">
            {{ di.icon_org() }}
            {% if isArea %}
                <div><b>Area-level lens &mdash; confined to {{ area.name }}.</b> Everything on this page is already
                    scoped to this one area. Managed at the organisation; inside {{ area.name }} it appears inherited.</div>
            {% else %}
                <div><b>Org-level lens &mdash; reads across every area.</b> This department has no single area, so its
                    view aggregates the whole organisation. Its scope can be confined to one area from
                    <a href="{{ path('team_departments') }}">the manager</a> &mdash; the change is audited.</div>
            {% endif %}
        </div>

        <div class="atabs">
            <button type="button" class="on" data-tab="overview"
                    data-uhifadhi--team-bundle--department-target="tab"
                    data-action="uhifadhi--team-bundle--department#tab">Overview</button>
            <button type="button" data-tab="performance"
                    data-uhifadhi--team-bundle--department-target="tab"
                    data-action="uhifadhi--team-bundle--department#tab">Performance</button>
            <button type="button" data-tab="people"
                    data-uhifadhi--team-bundle--department-target="tab"
                    data-action="uhifadhi--team-bundle--department#tab">People &amp; Positions</button>
            <button type="button" data-tab="settings"
                    data-uhifadhi--team-bundle--department-target="tab"
                    data-action="uhifadhi--team-bundle--department#tab">Settings</button>
        </div>

        {# ── OVERVIEW ── the identity card lives here and ONLY here. ── #}
        <section data-tab-panel="overview" data-uhifadhi--team-bundle--department-target="tabpanel">
            <div class="factband">
                <span class="f"><span class="k">Scope</span><span class="v">{{ isArea ? 'Area-level' : 'Org-level' }}</span></span>
                {% if isArea %}
                    <span class="f"><span class="k">Area</span><span class="v">{{ area.name }}</span></span>
                {% endif %}
                <span class="f"><span class="k">Code</span><span class="v uuid">{{ department.uuidString }}</span></span>
                <span class="f"><span class="k">Positions</span><span class="v">{{ positions|length }}</span></span>
                <span class="f"><span class="k">People</span><span class="v">{{ headcount }}</span></span>
                <span class="sp"></span>
                <button type="button" class="more" data-tab="settings"
                        data-action="uhifadhi--team-bundle--department#tab">Department settings &rarr;</button>
            </div>

            <p class="pgsub" style="margin:0 0 16px">The record, composed &mdash; <b>the modules this department
                attaches lead</b>. A lens, not a fence: every card is the same shared data, listed first here.</p>

            <div class="grid" data-dept-modules>
                {% for module in attached %}
                    {# ONE CARD PER ATTACHED MODULE — the modules leading the view. The
                       figures under it are that module's own KPIs; a module that ships
                       none says so rather than showing a zero. #}
                    <div class="c">
                        <span class="tab">{{ module.name }}<span class="src">&middot; leads this lens</span></span>
                        {# SHARED OR ITS OWN — the same rows either way. A module two
                           departments attach is one module, listed first for both, and
                           neither can hide a row from the other. #}
                        <div class="chiprow">
                            {% set shared = sharing[module.slug]|default(0) %}
                            {% if shared > 1 %}
                                <span class="dp-chip shared" title="shared — the same rows, read through another lens">shared &middot; {{ shared }} departments</span>
                            {% else %}
                                <span class="dp-chip">this department</span>
                            {% endif %}
                        </div>
                        {% set figures = kpis|filter(kpi => kpi.moduleSlug == module.slug) %}
                        {% if figures is not empty %}
                            <div style="margin-top:8px">
                                {{ dp.kpi_rows(figures) }}
                            </div>
                        {% else %}
                            <p class="use">Leads for this department. It reports no figure of its own.</p>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="c">
                        <span class="tab">Modules<span class="src">&middot; the lens</span></span>
                        <div class="dp-empty">
                            <b>No modules attached yet</b>
                            <span>This department leads with nothing until a module is attached. Attach one from
                                <button type="button" class="more" data-tab="settings"
                                        data-action="uhifadhi--team-bundle--department#tab">Settings &rarr; Modules
                                    attached</button> &mdash; it grants nothing and hides nothing.</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# ── PERFORMANCE ── KPIs on a single row when the follow-up wires them. ── #}
        <section data-tab-panel="performance" data-uhifadhi--team-bundle--department-target="tabpanel">
            <div class="grid">
                <div class="c">
                    <span class="tab">This month<span class="src">&middot; the attached modules&rsquo; KPIs</span></span>
                    <p class="use">A department owns no numbers of its own &mdash; every figure is a module KPI rolled
                        up through this department&rsquo;s attachment. Detaching a module takes its figures off this
                        page; it never sets them to zero.</p>
                    {# ONE TILE PER FIGURE, laid on a single row — the label the module
                       gave it under the module's own name, and the value. #}
                    <div class="grid kstrip" style="margin-top:12px" data-dept-kpis>
                        {% if kpis is not empty %}
                            {{ dp.kpi_tiles(kpis) }}
                        {% else %}
                            <div class="dp-empty" style="grid-column:1/-1">
                                <b>No module KPIs this period</b>
                                <span>They arrive with the first attached module that reports one &mdash; a department
                                    computes no figure of its own.</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        {# ── PEOPLE & POSITIONS ── the real positions filed under this department. ── #}
        <section data-tab-panel="people" data-uhifadhi--team-bundle--department-target="tabpanel">
            <div class="scoperule">
                {{ pm.icon_info() }}
                <div>People are in this department only through the <b>position</b> they hold &mdash; there is no
                    &ldquo;add person to department&rdquo;, by design. Manage positions on the matrix.</div>
            </div>
            <div class="grid">
                <div class="c">
                    <span class="tab">Positions &amp; members<span class="src">&middot; via position</span></span>
                    {% if positions|length %}
                        <div style="margin-top:6px">
                            {% for position in positions %}
                                <div class="posrow">
                                    <span class="pn"><a href="{{ path('team_positions', {position: position.uuidString}) }}">{{ position.name }}</a></span>
                                    <div class="pp">
                                        {% for value in position.permissionValues %}
                                            <span class="perm">{{ value }}</span>
                                        {% else %}
                                            <span class="pl-mem">no permissions granted</span>
                                        {% endfor %}
                                    </div>
                                    <div class="hb">
                                        {% set held = holders[position.uuidString]|default(0) %}
                                        {{ held }} {{ held == 1 ? 'holder' : 'holders' }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="dp-empty"><b>No positions in this department yet</b>
                            <span>A position is born in a department on the matrix. Until one is filed here, this
                                department leads nobody.</span></div>
                    {% endif %}
                    <a class="softbtn" href="{{ path('team_positions') }}" style="margin-top:12px">{{ pm.icon_people() }} Manage positions</a>
                </div>
            </div>
        </section>

        {# ── SETTINGS ── the scope facts (real), and the attachment surface (follow-up). ── #}
        <section data-tab-panel="settings" data-uhifadhi--team-bundle--department-target="tabpanel">
            <div class="grid g2">
                <div class="c">
                    <span class="tab">Scope</span>
                    <div style="margin-top:8px">
                        <div class="rln"><span class="k">Scope</span><span class="v">{{ isArea ? 'Area-level · ' ~ area.name : 'Org-level' }}</span></div>
                        <div class="rln"><span class="k">Reads</span><span class="v">{{ isArea ? area.name ~ ' only' : 'every area' }}</span></div>
                        <div class="rln"><span class="k">Effect on data</span><span class="v acc">none &mdash; emphasis only</span></div>
                    </div>
                    <p class="use">Change a department&rsquo;s scope from <a href="{{ path('team_departments') }}">the
                        manager</a> &mdash; it is audited, and confining an org-wide one ripples to its positions.</p>
                </div>
                <div class="c">
                    <span class="tab">Modules attached<span class="src">&middot; the lens</span></span>

                    {# THE ATTACHED SET — one row each, with the detach control on it.
                       Nothing attached is a line, not an absent card: a department that
                       leads with nothing should say so. #}
                    <div data-dept-attached>
                        {% for module in attached %}
                            <div class="setrow">
                                <span class="sn"><b>{{ module.name }}</b></span>
                                {% set shared = sharing[module.slug]|default(0) %}
                                {% if shared > 1 %}
                                    <span class="dp-chip shared">shared &middot; {{ shared }} departments</span>
                                {% else %}
                                    <span class="fog mono">&mdash; this department only</span>
                                {% endif %}
                                <span class="sx">
                                    <form method="post" action="{{ path('team_department_module_toggle', {uuid: department.uuidString, slug: module.slug}) }}">
                                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                                        <button class="softbtn danger" type="submit">{{ di.icon_detach() }} Detach</button>
                                    </form>
                                </span>
                            </div>
                        {% else %}
                            <p class="use">Nothing attached.</p>
                        {% endfor %}
                    </div>

                    {# WHAT IS LEFT TO ATTACH — the installation's catalogue minus what
                       this department already leads with. A module nobody installed is
                       not offered, because attaching it would point at code this
                       deployment does not have. #}
                    <div class="chiprow" data-dept-attach>
                        <span class="lbl">Attach</span>
                        {% for module in detached %}
                            <form method="post" action="{{ path('team_department_module_toggle', {uuid: department.uuidString, slug: module.slug}) }}">
                                <input type="hidden" name="_token" value="{{ csrfToken }}">
                                <button class="dchip" type="submit">{{ module.name }}</button>
                            </form>
                        {% else %}
                            <span class="fog mono">&mdash; every installed module is attached</span>
                        {% endfor %}
                    </div>

                    <p class="use">Attaching a module makes it <b>lead</b> for this department&rsquo;s people &mdash;
                        it grants nothing and hides nothing. A module claimed by two departments is one module,
                        listed first for both.</p>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
