{# DEPARTMENTS — the area-aware manager (the register).

   PORTED from the canonical design DesignsProjects/uhifadhi-web/departments/
   index.html: area-linked departments first, grouped under their area's name,
   then org-wide; an explicit SCOPE column on every row; create per-area (the
   picker enumerates the installation's areas through the contract) OR per-org,
   area-first because it is the correctable choice; and the audited scope change
   — confine to an area, or promote to org-wide, a reason required. Every row
   opens the department's own lens through its name and its Lens action.

   DEACTIVATE is drawn as the design's per-row danger action: it flips the
   department's active flag (deactivate, never delete), the footprint informs
   without guarding, and a deactivated row reads greyed with a Reactivate action.

   WHAT THE DESIGN DRAWS THAT IS THE RICH-LENS FOLLOW-UP, and so not here yet:
   the Widgets button in the header (the department's widget board). #}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/positions/_bits.html.twig' as pm %}
{% import '@Team/departments/_bits.html.twig' as di %}

{% block title %}Departments{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> / departments
{% endblock %}

{% block shell_page_title %}Departments{% endblock %}

{% block shell_page_subtitle %}Every department, created and scoped here.{% endblock %}

{% block shell_page_actions %}
    {# THE SAME TWO CONTROLS THE PERFORMANCE SECTION WEARS, because they ask
       the same two questions of the same seam: whose figures, and over what
       window. Every option is a link — the address is the state. #}
    <label class="ov-ctl">
        <span class="k">Scope</span>
        <details class="i-dd">
            <summary class="mchip i-ddt">
                <span class="i-ddval">{{ bandScope }}</span>
                <span class="i-ddcaret">&#9662;</span>
            </summary>
            <div class="i-ddmenu">
                <span class="i-ddhead">whose figures</span>
                <a class="i-ddopt{{ query.area ? '' : ' on' }}" href="{{ path('team_departments', query.with('area', null)) }}">
                    <span class="i-ddopt-l">Organization &mdash; all areas</span>
                </a>
                {% for area in areas %}
                    <a class="i-ddopt{{ query.area == area.uuidString ? ' on' }}"
                       href="{{ path('team_departments', query.with('area', area.uuidString)) }}">
                        <span class="i-ddopt-l">{{ area.name }}</span>
                    </a>
                {% endfor %}
            </div>
        </details>
    </label>

    {{ include('@Shell/_period_group.html.twig', {kinds: periodKinds, chosen: periodKind, urls: periodUrls}, with_context = false) }}
{% endblock %}

{% block shell_page %}
    {{ include('@Team/team/_scope_banner.html.twig') }}
    {% set hasAreas = areas|length > 0 %}
    <div data-dp>
        {# CREATE — the scope question first (area-first by default, the narrow
           correctable choice), then the name, and for an area, which one. #}
        <form class="crcard" method="post" action="{{ path('team_department_create') }}"
              data-controller="uhifadhi--team-bundle--department"
              data-scope="{{ hasAreas ? 'area' : 'org' }}"
              data-create-department
              data-uhifadhi--team-bundle--department-hint-area-value="<b>Just an area.</b> This department will belong only to the area you pick above and will not appear in the others &mdash; the safer default, and easy to widen later."
              data-uhifadhi--team-bundle--department-hint-org-value="<b>Org-wide.</b> This department will belong to the organization and appear in every area as an inherited department.">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <input type="hidden" name="scope" value="{{ hasAreas ? 'area' : 'org' }}"
                   data-uhifadhi--team-bundle--department-target="scopeField">
            <div class="crgrid">
                <div class="crfield">
                    <span class="crlab">Scope &mdash; just this area, or org-wide?</span>
                    <div class="seg" role="tablist">
                        <button type="button" class="{{ hasAreas ? 'on' : '' }}" data-scope-set="area"
                                {{ hasAreas ? '' : 'disabled' }}
                                data-uhifadhi--team-bundle--department-target="segment"
                                data-action="uhifadhi--team-bundle--department#setScope">{{ di.icon_area() }} Just an area</button>
                        <button type="button" class="{{ hasAreas ? '' : 'on' }}" data-scope-set="org"
                                data-uhifadhi--team-bundle--department-target="segment"
                                data-action="uhifadhi--team-bundle--department#setScope">{{ di.icon_org() }} Org-wide</button>
                    </div>
                </div>
                <div class="crfield crpick">
                    <span class="crlab">Which area?</span>
                    <select name="area" aria-label="Area">
                        {% for area in areas %}
                            <option value="{{ area.uuidString }}">{{ area.name }}</option>
                        {% else %}
                            <option value="">No areas yet</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="crfield grow">
                    <span class="crlab">Name</span>
                    <input type="text" class="fld" name="name" placeholder="New department"
                           aria-label="New department name" required>
                </div>
                <button class="cta" type="submit">{{ pm.icon_plus() }} Add department</button>
            </div>
            <div class="crhint">
                {{ pm.icon_info() }}
                <span data-uhifadhi--team-bundle--department-target="hint">
                    {% if hasAreas %}
                        <b>Just an area.</b> This department will belong only to the area you pick above and will not
                        appear in the others &mdash; the safer default, and easy to widen later.
                    {% else %}
                        <b>Org-wide.</b> There are no areas yet, so a department can only be organization-wide for now.
                        It will belong to the organization and appear in every area.
                    {% endif %}
                </span>
            </div>
        </form>

        {% set anyDepartments = departments|length > 0 %}

        {% if anyDepartments %}
            {# THE ORGANIZATION, ONCE — the slim identity band every register
               wears. IT CARRIES WHAT THE DEPARTMENTS DID, not how many of
               them there are: the modules' own figures through the
               performance seam, then the ground, the seats and the goals. A
               count of the cards below is a fact about the page, and it
               reads under the filters where such a count belongs. #}
            <div class="factband">
                {% for figure in band %}
                    <span class="f">
                        <span class="k">{{ figure.label }}</span>
                        <span class="v">{{ figure.figure ?: '—' }}
                            {%- if figure.caption or figure.delta %}<em>
                                {{- figure.caption }}
                                {%- if figure.caption and figure.delta %} &middot; {% endif %}
                                {%- if figure.delta %}<span class="d{{ figure.tone ? ' ' ~ figure.tone }}">{{ figure.delta }}</span>{% endif %}
                            </em>{% endif %}</span>
                    </span>
                {% endfor %}
                <span class="sp"></span>
                <a class="more" href="{{ path('team_performance') }}">Performance &rarr;</a>
            </div>

            {# FIND AND FILTER — the pills are the create chooser's own two
               words in the same order, and picking Area-level reveals the
               picker that narrows it further. Every one of them is a link:
               the address is the state. #}
            <div class="ov-find dcfind">
                <form class="lsearch" method="get" action="{{ path('team_departments') }}">
                    {{ ux_icon('shell:search') }}
                    <input class="fld" type="search" name="q" value="{{ query.search }}" placeholder="Find a department&hellip;"
                           aria-label="Find a department">
                    {% for k, v in query.with('q', null) %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                </form>
                <div class="dcfil">
                    {% for pill in [
                        {'value': 'all', 'label': 'All', 'n': counts.all},
                        {'value': 'org', 'label': 'Org-wide', 'n': counts.org},
                        {'value': 'area', 'label': 'Area-level', 'n': counts.area},
                    ] %}
                        <a class="dcpill{{ query.scope == pill.value ? ' on' : '' }}"
                           href="{{ path('team_departments', query.with('scope', pill.value == 'all' ? null : pill.value)) }}">{{ pill.label }} <span class="n">{{ pill.n }}</span></a>
                    {% endfor %}
                    {% if query.scope == 'area' and areas|length %}
                        <span class="dcarea">
                            <span class="k">Area</span>
                            <select aria-label="Narrow to one area" onchange="location = this.value">
                                <option value="{{ path('team_departments', query.with('area', null)) }}"{{ query.area ? '' : ' selected' }}>All areas</option>
                                {% for option in areas %}
                                    <option value="{{ path('team_departments', query.with('area', option.uuidString)) }}"{{ query.area == option.uuidString ? ' selected' : '' }}>{{ option.name }}</option>
                                {% endfor %}
                            </select>
                        </span>
                    {% endif %}
                    <span class="sp"></span>
                    {# WHAT IS BEING LISTED, under the thing listing it — where the
                       register's own counts belong, now that the band carries what
                       the departments DID rather than how many there are. #}
                    <span class="cnt">{{ counts.all }} departments &middot; {{ counts.org }} org-wide &middot; {{ counts.area }} area-level
                        &middot; {{ positionCount }} positions</span>
                </div>
            </div>

            {# ONE SECTION PER GROUP, foldable at its heading — a `<details>`,
               so it folds with no script of ours. #}
            {% set here = path('team_departments', query.with('focus', query.focus)) %}
            {% for group in groups %}
                <details class="nvsec" open>
                    <summary class="deptgroup nvgrp">
                        <span class="nvfold">{{ ux_icon('shell:chevron-right') }}</span>
                        <span class="gh">{{ group.label }}</span>
                        <span class="gc">{{ group.departments|length }}</span>
                        <span class="gnote">{{ group.note }}</span>
                        <span class="gl"></span>
                    </summary>
                    {% if group.departments is empty %}
                        <div class="zdnone">
                            <b>Nothing in {{ group.label }} matches</b>
                            <span>{{ query.isFiltered ? 'clear the search, or widen the filter' : 'no department has this scope yet' }}</span>
                        </div>
                    {% else %}
                        <div class="dcstack dcreg">
                            {% for department in group.departments %}
                                {{ include('@Team/departments/_card.html.twig', {
                                    department: department,
                                    positions: owned[department.uuidString]|default([]),
                                    people: headcount[department.uuidString]|default(0),
                                    figures: figures[department.uuidString]|default([]),
                                    modules: department.modules,
                                    holders: holders,
                                    areas: areas,
                                    mark: marks[department.uuidString]|default('—'),
                                    cat: cats[department.uuidString]|default(null),
                                    open: openDepartment == department.uuidString,
                                    focused: query.focus == department.uuidString,
                                    here: here,
                                    csrfToken: csrfToken,
                                }, with_context: false) }}
                            {% endfor %}
                        </div>
                    {% endif %}
                </details>
            {% endfor %}
        {% else %}
            <div class="pm-first">
                {{ pm.icon_plus() }}
                <div class="ft">
                    <h3>There are no departments yet, and the field above is what makes the first one.</h3>
                    <p>Until one exists, every position on this installation belongs to nobody in particular: the
                    roster&rsquo;s org chart bands them all as <b>Unassigned</b>. A department is an organizational
                    fact, so an installation that has not decided on one yet is simply an installation that has not
                    decided. Three or four is usually the whole list.</p>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}
