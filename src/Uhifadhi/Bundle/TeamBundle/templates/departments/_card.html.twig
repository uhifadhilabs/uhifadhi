{# ONE DEPARTMENT, AS A CARD ON THE REGISTER.

   Design: departments/index.html.

   THREE LEGIBLE REGIONS, and the house's own split: a banded HEADER with the
   mark, the name, the scope and what it reads; a BODY that opens to the
   positions filed under it; and a banded FOOTER where the operations that
   change the department live — separate work, visibly separate.

   OPEN AND FOCUSED ARE TWO DIFFERENT THINGS. Open is told by the body being
   there and the chevron having turned. FOCUSED is the card the sidebar's lit
   entry points at, and it is marked by a 2px accent line down the left edge
   inset by the card's radius — the accent is the mark, never the ground, and
   the box does not change size, so nothing below it moves when focus arrives.

   IT ONLY OFFERS WHAT THIS BUNDLE CAN DO. Seats per position and goals are
   not modelled, so the card states what it knows — who holds a position, and
   what the attached modules publish — and says the rest in words. #}
{% set uuid = department.uuidString %}
{% set area = department.area %}
{% set filled = people %}
<article id="d-{{ uuid }}" class="dcard{{ open ? ' on' : '' }}{{ focused ? ' dcfocus' : '' }}{{ department.active ? '' : ' dcinactive' }}"
         data-department="{{ uuid }}">
    {{ include('@Team/departments/_card_head.html.twig', {
        department: department, mark: mark, positions: positions, people: people,
        figures: figures, modules: modules, here: here, open: open, expandable: true,
    }, with_context: false) }}

    {% if open %}
        <div class="dc-body">
            <div class="ovexp">
                <div class="xhd">
                    <span class="k">Positions in {{ department.name }}</span>
                    <span class="n"><b>{{ positions|length }}</b> position{{ positions|length == 1 ? '' : 's' }} &middot; <b>{{ filled }}</b> {{ filled == 1 ? 'person' : 'people' }}</span>
                    <span class="sp"></span>
                    <a class="softbtn" href="{{ path('team_positions') }}">Open the positions page</a>
                </div>

                {# THE POSITIONS AS CARDS, three to a row, with the dashed add
                   tile in the same grid — the house's add treatment.

                   SEATS ARE NOT MODELLED, so a card states who holds the
                   position and nothing about how many could. "3 of 4 filled"
                   arrives with a seat count on the position itself. #}
                <div class="poscards">
                    {% for position in positions %}
                        {% set held = holders[position.uuidString]|default(0) %}
                        <a class="poscard" href="{{ path('team_positions', {position: position.uuidString}) }}">
                            <div class="poscardhd">
                                <span class="pospin{{ held ? '' : ' hollow' }}">{{ held ?: '' }}</span>
                                <b>{{ position.name }}</b>
                            </div>
                            <div class="poscardppl{{ held ? '' : ' empty' }}">
                                <span class="poscardlead">
                                    {{- held ? held ~ ' ' ~ (held == 1 ? 'person holds it' : 'people hold it') : 'nobody holds it yet' -}}
                                </span>
                            </div>
                            <div class="poscardfoot">
                                <span class="k">{{ area ? area.name|lower : 'org-wide' }}</span>
                                <span class="btn sm">Manage position &rarr;</span>
                            </div>
                        </a>
                    {% else %}
                        <div class="zdnone">
                            <span class="pospin hollow"></span>
                            <b>No position filed under {{ department.name }}</b>
                            <span>a department holds nobody directly &mdash; it holds the positions people fill</span>
                        </div>
                    {% endfor %}
                    <a class="poscard add" href="{{ path('team_positions') }}">
                        <span class="t">{{ ux_icon('shell:plus') }} Add position</span>
                        <span class="d">in {{ department.name }} &middot; inherits its scope</span>
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    {% set readOnly = readOnly|default(false) %}
    {# WHERE A WRITE RETURNS TO. The register leaves it unset and the writes
       answer with the register; a card on an area's configure section sets
       it to that section, so the page a person pressed the button on is the
       page they get back. #}
    {% set returnTo = returnTo|default(null) %}
    {# THE FOOTER IS ONE LINE UNTIL IT IS ASKED FOR MORE.

       A COLLAPSED CARD IS A ROW IN A LIST, and a register is read by running
       down the names. A footer that drew the confine form, the rename field
       and the deactivate button open would make every collapsed card a
       hundred pixels taller and turn the list into a stack of forms — so the
       strip states the scope, and the work sits behind two disclosures.

       BOTH ARE `<details>`, which open with no script of ours; the second
       stands in for the design's kebab, which a page with no script could
       not open at all. #}
    <div class="dc-foot">
        <div class="dc-line dc-scopeline">
            <span><b>Scope</b> &middot; <b>{{ area ? area.name : 'org-wide' }}</b> &mdash; {{ area ? 'the other areas do not see it' : 'every area reads it' }}</span>
            <span class="sp"></span>
{# A READING SURFACE DRAWS THE FACT AND NONE OF THE CONTROLS. The area's tab
   states a department's scope and sends every change to the two places that
   own one — this area's configure section, and the organisation's register
   for an org-wide department. #}
{% if not readOnly %}

            <details class="dc-more">
                <summary class="softbtn">{{ area ? 'Promote' : 'Change scope' }} &#9662;</summary>
                <div class="dc-panel">
                    <form class="dc-scopeform" method="post" action="{{ path('team_department_scope', {uuid: uuid}) }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        {% if returnTo %}<input type="hidden" name="_return" value="{{ returnTo }}">{% endif %}
                        {% if area %}
                            <input type="hidden" name="scope" value="org">
                            <b class="sbt">Promote {{ department.name }} to org-wide</b>
                            <label class="sbf grow"><span class="k">Reason &middot; required</span>
                                <input class="fld" type="text" name="reason" placeholder="Why promote {{ department.name }}?" aria-label="Reason for promoting {{ department.name }}" required>
                            </label>
                            <button class="softbtn" type="submit">Promote to org-wide</button>
                            <span class="sbn">Its {{ positions|length }} position{{ positions|length == 1 ? '' : 's' }} and the {{ filled }} {{ filled == 1 ? 'person' : 'people' }} in them widen to <b>every area</b>, which grants what they hold everywhere.</span>
                        {% else %}
                            <input type="hidden" name="scope" value="area">
                            <b class="sbt">Confine {{ department.name }} to one area</b>
                            <label class="sbf"><span class="k">To</span>
                                <select name="area" aria-label="Confine {{ department.name }} to area">
                                    {% for option in areas %}<option value="{{ option.uuidString }}">{{ option.name }}</option>{% endfor %}
                                </select>
                            </label>
                            <label class="sbf grow"><span class="k">Reason &middot; required</span>
                                <input class="fld" type="text" name="reason" placeholder="Why confine {{ department.name }}?" aria-label="Reason for confining {{ department.name }}" required>
                            </label>
                            <button class="softbtn danger" type="submit">Confine to area</button>
                            <span class="sbn">Its {{ positions|length }} position{{ positions|length == 1 ? '' : 's' }}, the {{ filled }} {{ filled == 1 ? 'person' : 'people' }} in them and its figures narrow to that area; the other areas stop inheriting it.</span>
                        {% endif %}
                    </form>
                </div>
            </details>

            {# THE REST OF THE OPERATIONS, in the design's kebab position and
               written as a disclosure rather than a menu: the same two things,
               reachable without a script. #}
            <details class="dc-more">
                <summary class="softbtn">More &#9662;</summary>
                <div class="dc-panel">
                    <form class="dc-renameform" method="post" action="{{ path('team_department_rename', {uuid: uuid}) }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        {% if returnTo %}<input type="hidden" name="_return" value="{{ returnTo }}">{% endif %}
                        <label class="sbf grow"><span class="k">Name</span>
                            <input class="fld" type="text" name="name" value="{{ department.name }}" maxlength="120" aria-label="Rename {{ department.name }}" required>
                        </label>
                        <button class="softbtn" type="submit">Rename</button>
                    </form>
                    {% if department.active %}
                        {# DEACTIVATE, NEVER DELETE, and the footprint informs
                           rather than guards: the shared confirm modal states
                           what stays filed, and the administrator proceeds. #}
                        <form method="post" action="{{ path('team_department_deactivate', {uuid: uuid}) }}" data-deactivate>
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                        {% if returnTo %}<input type="hidden" name="_return" value="{{ returnTo }}">{% endif %}
                            <button class="softbtn danger" type="submit"
                                    {{ stimulus_controller('confirm-modal') }}
                                    data-action="click->confirm-modal#ask"
                                    data-confirm-modal-title-value="Deactivate “{{ department.name }}”?"
                                    data-confirm-modal-message-value="{% if positions|length %}{{ positions|length }} position{{ positions|length == 1 ? '' : 's' }} ({{ filled }} {{ filled == 1 ? 'person' : 'people' }}) stay filed under it and keep what they grant.{% else %}Nothing is filed under it — an empty footprint.{% endif %} It is hidden from the pickers and greyed in the register; nothing is deleted, and it is one click from coming back."
                                    data-confirm-modal-confirm-label-value="Deactivate anyway"
                                    data-confirm-modal-danger-value="true">Deactivate anyway</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('team_department_reactivate', {uuid: uuid}) }}">
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                        {% if returnTo %}<input type="hidden" name="_return" value="{{ returnTo }}">{% endif %}
                            <button class="softbtn" type="submit">Reactivate</button>
                        </form>
                    {% endif %}
                </div>
            </details>
{% endif %}
        </div>
    </div>
</article>
