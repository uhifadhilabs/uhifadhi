{# ONE PERSON'S RECORD. Everything here writes to team_user; there is nothing on
   this page the schema cannot store. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/team/_bits.html.twig' as bits %}

{% block title %}{{ member.fullName }} &middot; team{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_page_tabs %}{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> / <a href="{{ path('team_index') }}">team</a> / {{ member.fullName|lower }}
{% endblock %}

{% block shell_page_title %}{{ member.fullName }}{% endblock %}

{# ONE LINE. What a tier is and what a permission is belong to Roles; this
   page is one person. #}
{% block shell_page_subtitle %}Everything this installation stores about one person, and what they may do.{% endblock %}

{% block shell_page_actions %}
    <a class="tgl w-act" href="{{ path('team_index') }}">{{ bits.icon_back() }} Back to the team</a>
    <button class="cta" type="submit" form="member-form">{{ bits.icon_save() }} Save changes</button>
{% endblock %}

{% block shell_page %}

{{ include('@Team/team/_scope_banner.html.twig') }}

<div class="mb-band">
    <span class="avatar">{{ bits.initials(member) }}</span>
    <div class="mb-id">
        <h2>{{ member.fullName }}</h2>
        <div class="mb-idrow">
            <span class="em">{{ member.email }}</span>
            {{ bits.tier_pill(member.teamRole) }}
            {% if member.rangerCode %}<span class="mb-code">{{ member.rangerCode|upper }}</span>{% endif %}
            {% if member.position %}
                <span class="qual">
                    {%- if member.position.department %}<span class="q">{{ member.position.department.name }}</span><span class="sep">/</span>{% endif -%}
                    <span class="n">{{ member.position.name }}</span>
                </span>
            {% endif %}
        </div>
    </div>
    {# IMPERSONATION IS A REAL, SHIPPED CAPABILITY, offered to a Super Admin
       only — TeamRoleEnum::canSwitch(). For anybody else this control is ABSENT
       rather than disabled. #}
    {% if mayImpersonate and not isSelf %}
        <div class="acts">
            <a class="softbtn" href="{{ path('team_index') }}?_switch_user={{ member.email|url_encode }}"
               title="Sign in as this person to reproduce what they see">
                {{ bits.icon_eye() }} Sign in as {{ member.firstName }}
            </a>
        </div>
    {% endif %}
</div>

{# THE SPLIT — the incident sheet's rail, on a record page: the record in the
   main column, and what happened to it and what may be done to it in the
   rail beside it. #}
<div class="mb-wrap">
<div class="mb-col">
    <div class="c">
        <span class="tab">The account<span class="src">&middot; sign-in state</span></span>

        {% if not member.isActive %}
            <div class="mb-state off">
                {{ bits.icon_off() }}
                <span><b>Deactivated &mdash; cannot sign in.</b>
                {%- if member.disabledAt %} <time datetime="{{ member.disabledAt|date('c') }}" data-localtime-format="day">{{ member.disabledAt|date('j M Y') }}</time> &middot;{% endif %}
                record kept, work keeps its author.</span>
                <span class="st-acts">
                    <form method="post" action="{{ path('team_member_reactivate', {uuid: member.uuidString}) }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        <button class="softbtn acc" type="submit">{{ bits.icon_undo() }} Reactivate</button>
                    </form>
                </span>
            </div>
        {% elseif member.isVerified %}
            <div class="mb-state ok">
                {{ bits.icon_check() }}
                <span><b>Signed in and verified.</b> Nothing to resend.</span>
                <span class="st-acts">
                    {# OFFERED AND REFUSED where there is no transport, never
                       hidden: the reason is on the control. #}
                    <form method="post" action="{{ path('team_member_reset_link', {uuid: member.uuidString}) }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        <button class="softbtn" type="submit"{% if not mailReady %} disabled title="No mailer configured &mdash; MAILER_DSN is unset"{% endif %}>{{ bits.icon_tag() }} Send a reset link</button>
                    </form>
                </span>
            </div>
        {% else %}
            <div class="mb-state wait">
                {{ bits.icon_warn() }}
                <span><b>Never signed in.</b>
                {%- if member.wasInvited %} Invited by {{ member.invitedBy ? member.invitedBy.fullName : 'somebody since removed' }}, {{ bits.ago(member.invitedAt) }}.
                {%- else %} Created with a password, handed over &middot; no invitation outstanding.{% endif %}</span>
                {% if member.wasInvited %}
                    <span class="st-acts">
                        <form method="post" action="{{ path('team_member_invite_again', {uuid: member.uuidString}) }}">
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                            <button class="softbtn" type="submit"{% if not mailReady %} disabled title="No mailer configured &mdash; MAILER_DSN is unset"{% endif %}>{{ bits.icon_save() }} Send the link again</button>
                        </form>
                    </span>
                {% endif %}
            </div>
        {% endif %}
    </div>

        <div class="c">
        <span class="tab">The record<span class="src">&middot; the columns team_user has</span></span>

        <form class="mb-form" id="member-form" method="post" action="{{ path('team_member_update', {uuid: member.uuidString}) }}" style="margin-top:14px">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="mb-f">
                <span class="lbl">first name</span>
                <input class="fld" name="firstName" value="{{ member.firstName }}" required maxlength="100">
                <p class="hint">Required &middot; <code>100</code></p>
            </div>
            <div class="mb-f">
                <span class="lbl">last name</span>
                <input class="fld" name="lastName" value="{{ member.lastName }}" required maxlength="100">
                <p class="hint">Required &middot; <code>100</code></p>
            </div>
            <div class="mb-f">
                <span class="lbl">email</span>
                <input class="fld" name="email" type="email" value="{{ member.email }}" required maxlength="180">
                <p class="hint">Sign-in identifier &middot; unique &middot; lowercased on save</p>
            </div>
            <div class="mb-f">
                <span class="lbl">ranger code</span>
                <input class="fld" name="rangerCode" value="{{ member.rangerCode }}" maxlength="32">
                <p class="hint">Unique &middot; nullable &mdash; blank stored as NULL</p>
            </div>
        </form>
    </div>

        <div class="c">
        <span class="tab">Tier<span class="src">&middot; who may administer the team</span></span>

        <form method="post" action="{{ path('team_member_tier', {uuid: member.uuidString}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="mb-tiers" style="margin-top:13px">
                {% for tier in tiers %}
                    <button type="submit" name="tier" value="{{ tier.value }}"
                            class="mb-tier{{ member.teamRole == tier ? ' on' : '' }}"
                            aria-pressed="{{ member.teamRole == tier ? 'true' : 'false' }}"
                            {{ isLastSuperAdmin and tier != member.teamRole ? 'disabled' : '' }}>
                        <span class="tt"><i></i><b>{{ tier.label }}</b></span>
                        <em>{{ tier.description }}</em>
                        <span class="grants">grants <b{{ tier.canManageContent ? '' : ' class="none"' }}>{{ tier.grants }}</b></span>
                    </button>
                {% endfor %}
            </div>
        </form>

        {# THE WARNING LIVES AT THE GRANT. Shown whenever this person is not already
           a Super Admin, because that is exactly when pressing the card hands
           somebody every permission the presser holds. #}
        {% if member.teamRole.value != 'super_admin' %}
            <div class="mb-grant">
                {{ bits.icon_warn() }}
                <div><b>Grants every permission you hold, including this one.</b> They can promote others, and
                demote you. Transfer before you leave.</div>
            </div>
        {% endif %}

        {# THE REFUSAL, WITH ITS REASON — not a greyed-out control and not a
           failure on submit. It unlocks the moment somebody else holds the tier. #}
        {% if isLastSuperAdmin %}
            <div class="mb-refuse">
                {{ bits.icon_warn() }}
                <span><b>Refused &mdash; last active Super Admin.</b> {{ member.fullName }} is the only one.
                Demote and deactivate unlock the moment somebody else holds it.</span>
            </div>
        {% endif %}
    </div>

        <div class="c">
        <span class="tab">Position<span class="src">&middot; the one control that changes what this person may do</span></span>

        {# ROW ONE — THE CONTROL, at the house field width, with its caption and
           its reach on the same line. #}
        <div class="mb-assign">
            <span class="lbl">assigned position</span>
            <div class="mb-assignrow">
                <form method="post" action="{{ path('team_member_position', {uuid: member.uuidString}) }}">
                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                    {# GROUPED BY DEPARTMENT, because that is where a name is
                       unique. Two of these options may be called "Analyst" and
                       a flat list would make them one. #}
                    <select class="sel" name="position" onchange="this.form.submit()">
                        <option value="">&mdash; no position &mdash;</option>
                        {% for department, positions in groupedPositions %}
                            <optgroup label="{{ department is empty ? 'No department yet' : department }}">
                                {% for position in positions %}
                                    <option value="{{ position.uuidString }}"{{ member.position == position ? ' selected' : '' }}>{{ position.name }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endfor %}
                    </select>
                    <noscript><button class="softbtn" type="submit" style="margin-top:8px">Assign</button></noscript>
                </form>
                <span class="hint">Grouped by department &middot; no position grants nothing</span>
                {% if member.position %}
                    <div class="pm-reach">{{ ux_icon("shell:users", {width: 13, height: 13}) }} held by {{ reach }} {{ reach == 1 ? 'person' : 'people' }}</div>
                {% endif %}
            </div>
        </div>

        {# ROW TWO, FULL WIDTH — what that actually grants, right now, in two
           balanced columns of the same row shape. #}
        <div class="mb-grants">
            <span class="lbl">what that actually grants, right now</span>
            <div class="pm-eff mb-eff2">
                {% for row in effective %}
                    <div class="pm-effrow{{ row.held ? '' : ' off' }}">
                        <span class="lhs">
                            <b>{% if row.why == 'orphaned grant' %}<span class="pm-orphname">{{ row.label }}</span>{% else %}{{ row.label }}{% endif %}</b>
                            <span class="perm">{{ row.value }}</span>
                        </span>
                        <span class="pm-why {{ row.held ? (row.why == 'by tier' ? 'tier' : 'pos') : 'no' }}">
                            {{- row.held ? bits.icon_tag() : bits.icon_off() }}{{ row.why -}}
                        </span>
                    </div>
                {% endfor %}
            </div>
            <p class="hint" style="font-size:11.5px;color:rgb(var(--c-dim));line-height:1.55;margin:13px 0 0">
                {%- if member.teamRole.canManageContent -%}
                    Every row says <b>by tier</b> &mdash; the position changes nothing they may do.
                {%- else -%}
                    Staff tier grants nothing &mdash; every row here comes from the position.
                    <a href="{{ path('team_positions') }}">Edit the position &rarr;</a>
                {%- endif -%}
            </p>
        </div>
    </div>

    {# POSTINGS — ONE FACT, TWO DOORS: the station page and this page. Read-only
       here, because a posting is made on the station, in the area. #}
    <div class="c">
        <span class="tab">Postings<span class="src">&middot; {{ postings|length }} &middot; read-only, made in the area</span></span>
        {% if postings is empty %}
            <div class="mb-empty" style="margin-top:14px">
                {{ bits.icon_warn() }}
                <span><b>Not posted to a station.</b> Nullable &middot; office-based staff have none.</span>
            </div>
        {% else %}
            <table class="tbl" style="margin-top:14px">
                <thead><tr><th>Station</th><th>Zone</th><th>Since</th><th></th></tr></thead>
                <tbody>
                {% for posting in postings %}
                    <tr>
                        <td><b>{{ posting.stationName }}</b>{% if posting.leader %} <span class="chip ok">leads</span>{% endif %}{% if posting.stationCode %} <span class="mono d">&middot; {{ posting.stationCode }}</span>{% endif %}</td>
                        <td><span class="mono d">{{ posting.zoneName ?? 'no zone' }}</span></td>
                        <td><span class="mono d"><time datetime="{{ posting.since|date('c') }}" data-localtime-format="day">{{ posting.since|date('j M Y') }}</time></span></td>
                        <td style="text-align:right"><span class="mono d">{{ posting.areaName }}</span></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>

<aside class="mb-rail">
    {# WHAT THIS INSTALLATION CAN TRUTHFULLY SAY HAPPENED — derived from the
       stored facts that carry a date, newest first, and bounded. #}
    <div class="c">
        <span class="tab">History<span class="src">&middot; latest {{ history|length }}</span></span>
        <div class="mb-log">
            {% for event in history %}
                <div class="mb-lrow">
                    <span class="mb-ldot{{ loop.first ? ' on' }}"></span>
                    <span><b>{{ event.title }}</b><span>{{ event.note }}</span></span>
                    <span class="mb-lwhen"><time datetime="{{ event.when|date('c') }}" data-localtime-format="daystamp">{{ event.when|date('j M Y') }}</time></span>
                </div>
            {% else %}
                <div class="mb-lrow"><span class="mb-ldot"></span><span><b>Nothing dated yet.</b></span></div>
            {% endfor %}
        </div>
        {% if historyTotal > history|length %}
            <div class="sxmore"><span>{{ history|length }} of {{ historyTotal }}</span><span class="sp"></span></div>
        {% endif %}
    </div>

    {# ACCOUNT ACTIONS — THREE, and no fourth. Accounts are never hard-deleted,
       and a screen does not name an action that does not exist. #}
    <div class="c">
        <span class="tab">Account actions<span class="src">&middot; three</span></span>

        <div class="mb-danger">
            {% if member.isActive %}
                <div class="mb-drow">
                    <div class="dt"><b>Send a password-reset link</b>
                    <em>Writes a token, mails a link &middot; does not change the password</em></div>
                    <form method="post" action="{{ path('team_member_reset_link', {uuid: member.uuidString}) }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        <button class="softbtn" type="submit"{% if not mailReady %} disabled title="No mailer configured &mdash; MAILER_DSN is unset"{% endif %}>{{ bits.icon_tag() }} Send</button>
                    </form>
                </div>
            {% endif %}

            {% if mayImpersonate and not isSelf %}
                <div class="mb-drow">
                    <div class="dt"><b>Sign in as this person</b>
                    <em>Super Admin only &middot; absent for anybody else</em></div>
                    <a class="softbtn" href="{{ path('team_index') }}?_switch_user={{ member.email|url_encode }}">{{ bits.icon_eye() }} Switch</a>
                </div>
            {% endif %}

            {% if member.isActive %}
                <div class="mb-drow">
                    <div class="dt"><b>Deactivate the account</b>
                    <em>Sets inactive, stamps the date &middot; record kept, reversible &middot; refused for the last Super Admin</em></div>
                    {% if isLastSuperAdmin %}
                        <span class="mb-absent">{{ bits.icon_off() }} refused &mdash; the last active Super Admin</span>
                    {% else %}
                        <form method="post" action="{{ path('team_member_deactivate', {uuid: member.uuidString}) }}">
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                            <button class="softbtn danger" type="submit">{{ bits.icon_off() }} Deactivate</button>
                        </form>
                    {% endif %}
                </div>
            {% else %}
                <div class="mb-drow">
                    <div class="dt"><b>Reactivate the account</b>
                    <em>Clears the flag and drops the date &middot; a stale &ldquo;disabled at&rdquo; on a live account reads as true and is not</em></div>
                    <form method="post" action="{{ path('team_member_reactivate', {uuid: member.uuidString}) }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        <button class="softbtn acc" type="submit">{{ bits.icon_undo() }} Reactivate</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</aside>
</div>
{% endblock %}
