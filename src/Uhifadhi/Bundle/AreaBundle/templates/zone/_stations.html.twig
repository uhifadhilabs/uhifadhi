{# THE STATIONS OF A SELECTION, as the zones pages draw them.

   ONE SHAPE, TWO SURFACES: the zones tab draws every post in the area and
   needs the zone column; a zone record draws its own and does not, because
   the answer would be the same word on every row. #}
<div class="ovx-tbl">
    <table class="tbl zdtbl">
        {# THE COLUMNS ARE NAMED. A table whose header row sits loose in the
           body is a table the browser files under `tbody` — it still draws,
           but it scrolls away with the rows and reads as a first row of
           shouting text. #}
        <thead>
            <tr>
                <th>Station</th>
                <th>Code</th>
                {% if withZone %}<th>Zone</th>{% endif %}
                <th>Point</th>
                <th class="num">Posted</th>
                <th>Lead</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td class="zname">
                    <span class="zn-in">
                        <span class="stpin{{ row.posted ? '' : ' hollow' }}">{{ row.posted ?: '' }}</span>
                        <b>{{ row.name }}</b>
                    </span>
                </td>
                <td class="mono d">{{ row.code ?? '&mdash;'|raw }}</td>
                {% if withZone %}
                    <td>
                        {%- if row.zoneName -%}
                            <span class="stzone"><i{% if row.zoneHue %} style="background:{{ row.zoneHue }}"{% endif %}></i>{{ row.zoneName }}</span>
                        {%- else -%}
                            <em class="pnone">unzoned</em>
                        {%- endif -%}
                    </td>
                {% endif %}
                <td class="mono d">{{ row.point ? row.point.label : '&mdash;'|raw }}</td>
                <td class="num">{{ row.posted ?: '<em class="pnone">nobody posted</em>'|raw }}</td>
                <td>{{ row.led ? 'appointed' : '<em class="pnone">no lead</em>'|raw }}</td>
                <td class="act">
                    <a class="open-btn" href="{{ path('area_station_show', {uuid: area.uuidString, station: row.uuid}) }}">Open {{ ux_icon('shell:arrow-right') }}</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
