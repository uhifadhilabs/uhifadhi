{# THE MODULE SHOP — choose which modules this area has, and the order it shows
   them in.

   Design: areas/<area>/modules/customize.html in the design workspace.

   TWO SYNCED VIEWS OF ONE SET, exactly as drawn: the compact pills at the top
   and the detailed rows below are the same active modules. Dragging in either
   reorders both, and the × on a pill does what the row's toggle does. They are
   kept in step by SLUG, which is also what every write posts — the registry's ledger
   is addressed by slug, so nothing here has to know an assignment's uuid.

   EVERY CONTROL IS A REAL FORM. The drag ordering is the one thing that needs
   JavaScript, and it posts the same route by hand; switching a module on or off
   is a button in a form and works with scripting off. A shop whose only way to
   park a module was a drag would be unusable from a keyboard.

   ONE TOKEN FOR THE WHOLE PAGE, scoped to this area. The design mints a separate
   token per control; that is three token ids to keep in step for one
   authorization decision — "may this viewer compose THIS area" — which is
   already answered once by module.create on every action.

   THE PLATE CARRIES NO WIDGET INDEX — the design file's `PL·91` / `PL·92` are the
   workspace's referencing system and not product. See
   tests/Unit/Template/NoWorkshopLabelsTest.php. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}Customize modules{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Area/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('area_index') }}">uhifadhi</a> /
    <a href="{{ path('area_index') }}">areas</a> /
    <a href="{{ path('area_show', {uuid: area.uuidString}) }}">{{ area.name|lower }}</a> /
    <a href="{{ path('area_modules', {uuid: area.uuidString}) }}">modules</a> / customize
{% endblock %}

{% block shell_page_title %}{{ area.name }} &mdash; Customize modules{% endblock %}

{% block shell_page_subtitle %}Choose which modules appear on this area and drag to set their order &mdash; a per-area module shop.{% endblock %}

{# ONE DOOR OUT, AND IT GOES BACK TO THE GRID. The design draws "Cancel" beside
   "Done" and points both at the area's overview. Cancel is a promise this screen
   cannot keep: every control here has already written and redirected by the time
   anybody reaches the corner, so a button offering to undo that would be a lie
   with a label on it. And the grid is where you came from and what you just
   changed — sending "Done" past it to the overview skips the page the work was
   about. #}
{% block shell_page_actions %}
    <a class="tgl" href="{{ path('area_modules', {uuid: area.uuidString}) }}">Done</a>
{% endblock %}

{% macro chip(status) %}
    {%- set word = {'live': 'live', 'template': 'template'}[status]|default('planned') -%}
    {%- set tone = {'live': 'ok', 'template': 'warn'}[status]|default('idle') -%}
    <span class="chip {{ tone }}">{{ word }}</span>
{% endmacro %}

{% macro park(area, row, token, label, title, class) %}
    <form method="post" action="{{ path('area_module_uninstall', {uuid: area.uuidString}) }}">
        <input type="hidden" name="_token" value="{{ token }}">
        <input type="hidden" name="module" value="{{ row.slug }}">
        <button type="submit" class="{{ class }}" title="{{ title }}">{{ label|raw }}</button>
    </form>
{% endmacro %}

{% block shell_page %}
    {% import _self as shop %}

    <div data-controller="uhifadhi--area-bundle--module-order"
         data-uhifadhi--area-bundle--module-order-url-value="{{ path('area_module_reorder', {uuid: area.uuidString}) }}"
         data-uhifadhi--area-bundle--module-order-token-value="{{ token }}">

        <div class="a-pin-bar" data-uhifadhi--area-bundle--module-order-target="list">
            {% for row in active %}
                {% if row.pinned %}
                    <span class="mchip a-pin pinned">{{ row.name }}<span class="mono pinlabel">pinned</span></span>
                {% else %}
                    <span class="mchip a-pin" data-uhifadhi--area-bundle--module-order-target="row" data-slug="{{ row.slug }}">
                        <span class="grip" data-uhifadhi--area-bundle--module-order-target="handle" title="drag to reorder">{{ ux_icon('lucide:grip-vertical') }}</span>{{ row.name }}
                        {{ shop.park(area, row, token, '&times;', 'remove module', 'rm') }}
                    </span>
                {% endif %}
            {% endfor %}
        </div>

        <div class="c mod-banner">
            <div class="t">Compose this area&rsquo;s sub-app</div>
            <div class="d">Drag the <b>pills</b> or the <b>rows</b> below to reorder &mdash; they mirror each
                other. Toggle a row off (or &times; a pill) to park a module; add parked ones on the right.</div>
        </div>

        <div class="mod-grid">
            {# ── What is on ─────────────────────────────────────────────── #}
            <div class="c" id="modules-active">
                <span class="tab">Active modules<span class="src">&middot; drag to reorder</span></span>
                <span class="lib">{{ active|length }} on</span>

                <div class="mod-rows" data-uhifadhi--area-bundle--module-order-target="list">
                    {% for row in active %}
                        <div class="mod-row{{ row.pinned ? ' pinned' }}"
                             {% if not row.pinned %}data-uhifadhi--area-bundle--module-order-target="row" data-slug="{{ row.slug }}"{% endif %}>
                            {% if row.pinned %}
                                {# THE HUB IS NOT A CHOICE. A pinned module is what
                                   the area IS rather than something composed onto
                                   it, so it carries no grip and no switch — the
                                   registry refuses to park it anyway, and a control
                                   that silently does nothing is worse than none. #}
                                <span class="mod-grip-gap"></span>
                                <span class="mod-name">{{ row.name }}</span>
                                {{ shop.chip(row.status) }}
                                <span class="mod-spacer"></span>
                                <span class="mod-pin">always on &middot; pinned</span>
                            {% else %}
                                <span class="mod-grip" data-uhifadhi--area-bundle--module-order-target="handle" title="drag to reorder">{{ ux_icon('lucide:grip-vertical') }}</span>
                                <span class="mod-name">{{ row.name }}</span>
                                {{ shop.chip(row.status) }}
                                <span class="mod-spacer"></span>
                                {% if row.source %}<span class="mod-src">{{ row.source }}</span>{% endif %}
                                {{ shop.park(area, row, token, '', 'switch off — parks the module', 'mod-toggle on') }}
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="zeb">Nothing is switched on for this area yet. Add a module from the
                            shop on the right &mdash; until one is on, this area has no pages beyond its
                            own overview.</p>
                    {% endfor %}
                </div>

                <div class="use"><b>The order here is the order modules appear</b> on the area. Drag to
                    rearrange; switch a row off to park a module &mdash; its data stays, it just leaves
                    the area.</div>
            </div>

            {# ── What is parked ─────────────────────────────────────────── #}
            <div class="c" id="modules-shop">
                <span class="tab">Inactive modules<span class="src">&middot; {{ parkedCount }} parked</span></span>

                <div class="mod-parked-list">
                    {% for category, rows in parkedByCategory %}
                        <div class="mod-cat">{{ category }}</div>
                        {% for row in rows %}
                            {# TWO KINDS OF CARD, DRAWN THE SAME. One is a module
                               this area switched off; one it has never had a row
                               for. Both are switched on by the same slug, so the
                               difference changes nothing anybody can do with them. #}
                            <div class="mod-parked">
                                <div class="body">
                                    <div class="name">{{ row.name }} {{ shop.chip(row.status) }}</div>
                                    {% if row.source %}<div class="mod-parked-src"><span class="mod-src">{{ row.source }}</span></div>{% endif %}
                                </div>
                                <form method="post" action="{{ path('area_module_install', {uuid: area.uuidString}) }}">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <input type="hidden" name="module" value="{{ row.slug }}">
                                    <button type="submit" class="cta">+ Add</button>
                                </form>
                            </div>
                        {% endfor %}
                    {% else %}
                        <p class="zeb">Every module in the catalogue is switched on for this area &mdash;
                            nothing parked.</p>
                    {% endfor %}
                </div>

                <div class="use">Modules parked here don&rsquo;t appear on the area &mdash; their data stays
                    intact. Press <b>+ Add</b> to switch one back on; it moves to Active. Each card shows
                    its status and the data source it needs.</div>
            </div>
        </div>
    </div>
{% endblock %}
